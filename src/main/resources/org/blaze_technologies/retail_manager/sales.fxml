<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1" fx:id="salesRoot"
	fx:controller="org.blaze_technologies.retail_manager.controllers.SalesController"
	styleClass="sales">

	<padding>
		<Insets top="22" right="28" bottom="20" left="28" />
	</padding>


	<!-- ===================================================== HEADER ===================================================== -->

	<top>

		<HBox alignment="BOTTOM_LEFT" spacing="20"
			styleClass="sales-header">

			<VBox spacing="3">

				<Label text="Sales" styleClass="page-title" />

				<Label text="Create and manage sales"
					styleClass="page-subtitle" />

			</VBox>

			<HBox HBox.hgrow="ALWAYS" />

			<HBox spacing="6" styleClass="mode-indicator">

				<Label text="NEW SALE" styleClass="mode-active" />

				<Label text="F3" styleClass="mode-key" />

			</HBox>

		</HBox>

	</top>


	<!-- ===================================================== CENTER ===================================================== -->

	<center>

		<TabPane fx:id="salesTabs" tabClosingPolicy="UNAVAILABLE"
			styleClass="sales-tabs">

			<!-- ================================================= NEW SALE ================================================= -->

			<Tab text="New Sale" closable="false">

				<BorderPane styleClass="new-sale">

					<padding>
						<Insets top="14" right="0" bottom="0" left="0" />
					</padding>


					<!-- ========================================= LEFT SIDE ========================================= -->

					<left>

						<VBox prefWidth="470" spacing="14"
							styleClass="sale-entry-area">


							<!-- SEARCH -->

							<VBox spacing="7">

								<Label text="PRODUCT" styleClass="field-label" />

								<HBox spacing="8">

									<TextField fx:id="productSearchField"
										promptText="Search product or scan barcode"
										HBox.hgrow="ALWAYS" styleClass="product-search" />

									<Button text="Search" mnemonicParsing="false"
										styleClass="search-button" />

								</HBox>

								<HBox spacing="8">

									<Label text="Type to search" styleClass="field-hint" />

									<Label text="•" styleClass="field-hint" />

									<Label text="Scanner ready" styleClass="field-hint" />

								</HBox>

							</VBox>


							<!-- SEARCH RESULTS -->

							<VBox VBox.vgrow="ALWAYS" spacing="7"
								styleClass="product-results">

								<HBox alignment="CENTER_LEFT">

									<Label text="PRODUCTS" styleClass="field-label" />

									<HBox HBox.hgrow="ALWAYS" />

									<Label text="↑ ↓ Select" styleClass="navigation-hint" />

								</HBox>

								<ListView fx:id="productResultsList"
									VBox.vgrow="ALWAYS" styleClass="product-list" />

							</VBox>


							<!-- SELECTED PRODUCT -->

							<VBox spacing="12" styleClass="selected-product">

								<HBox alignment="CENTER_LEFT">

									<VBox spacing="2">

										<Label text="SELECTED PRODUCT" styleClass="field-label" />

										<Label fx:id="selectedProductName"
											text="Select a product" styleClass="selected-product-name" />

									</VBox>

									<HBox HBox.hgrow="ALWAYS" />

									<VBox alignment="CENTER_RIGHT" spacing="2">

										<Label text="PRICE" styleClass="field-label" />

										<Label fx:id="selectedProductPrice" text="Rs. 0.00"
											styleClass="selected-price" />

									</VBox>

								</HBox>


								<GridPane hgap="10" vgap="5">

									<columnConstraints>

										<ColumnConstraints percentWidth="32" />

										<ColumnConstraints percentWidth="34" />

										<ColumnConstraints percentWidth="34" />

									</columnConstraints>


									<Label text="QUANTITY" GridPane.columnIndex="0"
										GridPane.rowIndex="0" styleClass="field-label" />

									<Label text="UNIT PRICE" GridPane.columnIndex="1"
										GridPane.rowIndex="0" styleClass="field-label" />

									<Label text="DISCOUNT" GridPane.columnIndex="2"
										GridPane.rowIndex="0" styleClass="field-label" />


									<TextField fx:id="quantityField" text="1"
										GridPane.columnIndex="0" GridPane.rowIndex="1"
										styleClass="number-field" />

									<TextField fx:id="unitPriceField" text="0.00"
										GridPane.columnIndex="1" GridPane.rowIndex="1"
										styleClass="number-field" />

									<TextField fx:id="discountField" text="0.00"
										GridPane.columnIndex="2" GridPane.rowIndex="1"
										styleClass="number-field" />

								</GridPane>


								<Button text="Add Item" mnemonicParsing="false"
									maxWidth="Infinity" styleClass="add-item-button" />

							</VBox>

						</VBox>

					</left>


					<!-- ========================================= RIGHT SIDE — CURRENT 
						SALE ========================================= -->

					<center>

						<VBox spacing="12" styleClass="current-sale-panel">

							<HBox alignment="CENTER_LEFT">

								<VBox spacing="2">

									<Label text="CURRENT SALE"
										styleClass="current-sale-title" />

									<Label text="New transaction"
										styleClass="current-sale-subtitle" />

								</VBox>

								<HBox HBox.hgrow="ALWAYS" />

								<Label text="# NEW" styleClass="sale-reference" />

							</HBox>


							<Separator />


							<!-- TABLE -->

							<TableView fx:id="saleItemsTable" VBox.vgrow="ALWAYS"
								styleClass="sale-table">

								<columns>

									<TableColumn fx:id="itemColumn" text="ITEM"
										prefWidth="250" />

									<TableColumn fx:id="quantityColumn" text="QTY"
										prefWidth="65" />

									<TableColumn fx:id="priceColumn" text="PRICE"
										prefWidth="105" />

									<TableColumn fx:id="discountColumn" text="DISC."
										prefWidth="85" />

									<TableColumn fx:id="totalColumn" text="TOTAL"
										prefWidth="115" />

								</columns>

							</TableView>


							<!-- TABLE ACTIONS -->

							<HBox alignment="CENTER_LEFT" spacing="8">

								<Button text="Remove Item" mnemonicParsing="false"
									styleClass="table-action" />

								<Button text="Edit Item" mnemonicParsing="false"
									styleClass="table-action" />

								<HBox HBox.hgrow="ALWAYS" />

								<Label text="Enter" styleClass="action-key" />

								<Label text="Add" styleClass="action-label" />

							</HBox>


							<Separator />


							<!-- TOTAL -->

							<VBox spacing="8" styleClass="sale-total">

								<HBox alignment="CENTER_LEFT">

									<Label text="SUBTOTAL" styleClass="summary-label" />

									<HBox HBox.hgrow="ALWAYS" />

									<Label fx:id="subtotalLabel" text="Rs. 0.00"
										styleClass="summary-value" />

								</HBox>

								<HBox alignment="CENTER_LEFT">

									<Label text="DISCOUNT" styleClass="summary-label" />

									<HBox HBox.hgrow="ALWAYS" />

									<Label fx:id="totalDiscountLabel" text="Rs. 0.00"
										styleClass="summary-value" />

								</HBox>

								<HBox alignment="CENTER_LEFT" styleClass="grand-total">

									<Label text="TOTAL" styleClass="total-label" />

									<HBox HBox.hgrow="ALWAYS" />

									<Label fx:id="grandTotalLabel" text="Rs. 0.00"
										styleClass="total-value" />

								</HBox>

							</VBox>


							<!-- PAYMENT -->

							<Button text="Proceed to Payment" mnemonicParsing="false"
								maxWidth="Infinity" styleClass="payment-button" />

						</VBox>

					</center>

				</BorderPane>

			</Tab>


			<!-- ================================================= SALES HISTORY ================================================= -->

			<Tab text="Sales History" closable="false">

				<BorderPane styleClass="sales-history">

					<padding>
						<Insets top="18" right="0" bottom="0" left="0" />
					</padding>


					<top>

						<HBox spacing="10" alignment="CENTER_LEFT">

							<TextField fx:id="salesHistorySearchField"
								promptText="Search invoice, customer, or reference"
								HBox.hgrow="ALWAYS" styleClass="history-search" />

							<Button text="Search" mnemonicParsing="false"
								styleClass="search-button" />

							<Button text="Today" mnemonicParsing="false"
								styleClass="filter-button" />

							<Button text="Date" mnemonicParsing="false"
								styleClass="filter-button" />

						</HBox>

					</top>


					<center>

						<TableView fx:id="salesHistoryTable"
							styleClass="history-table">

							<columns>

								<TableColumn fx:id="historyDateColumn" text="DATE"
									prefWidth="130" />

								<TableColumn fx:id="historyInvoiceColumn"
									text="INVOICE" prefWidth="130" />

								<TableColumn fx:id="historyCustomerColumn"
									text="CUSTOMER" prefWidth="220" />

								<TableColumn fx:id="historyItemsColumn" text="ITEMS"
									prefWidth="80" />

								<TableColumn fx:id="historyAmountColumn"
									text="AMOUNT" prefWidth="140" />

								<TableColumn fx:id="historyPaymentColumn"
									text="PAYMENT" prefWidth="130" />

								<TableColumn fx:id="historyStatusColumn"
									text="STATUS" prefWidth="110" />

							</columns>

						</TableView>

					</center>

				</BorderPane>

			</Tab>

		</TabPane>

	</center>

</BorderPane>