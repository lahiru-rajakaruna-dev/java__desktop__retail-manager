<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:id="customersRoot"
	fx:controller="org.blaze_technologies.retail_manager.controllers.CustomersController"
	styleClass="customers">

	<padding>
		<Insets top="22" right="28" bottom="20" left="28" />
	</padding>


	<!-- ===================================================== HEADER ===================================================== -->

	<top>

		<HBox alignment="BOTTOM_LEFT" spacing="20"
			styleClass="customers-header">

			<VBox spacing="3">

				<Label text="Customers" styleClass="page-title" />

				<Label text="Customers and outstanding balances"
					styleClass="page-subtitle" />

			</VBox>

			<HBox HBox.hgrow="ALWAYS" />

			<HBox spacing="18" alignment="BOTTOM_RIGHT">

				<VBox alignment="BOTTOM_RIGHT" spacing="2">

					<Label text="CUSTOMERS" styleClass="header-label" />

					<Label fx:id="customerCountLabel" text="0"
						styleClass="header-value" />

				</VBox>

				<VBox alignment="BOTTOM_RIGHT" spacing="2">

					<Label text="OUTSTANDING" styleClass="header-label" />

					<Label fx:id="outstandingBalanceLabel" text="Rs. 0.00"
						styleClass="header-debt-value" />

				</VBox>

			</HBox>

		</HBox>

	</top>


	<!-- ===================================================== CENTER ===================================================== -->

	<center>

		<TabPane fx:id="customersTabs" tabClosingPolicy="UNAVAILABLE"
			styleClass="customers-tabs">


			<!-- ================================================= CUSTOMERS TAB ================================================= -->

			<Tab text="Customers" closable="false">

				<BorderPane styleClass="customers-content">

					<padding>
						<Insets top="16" right="18" bottom="18" left="18" />
					</padding>


					<!-- ========================================= TOOLBAR ========================================= -->

					<top>

						<HBox alignment="CENTER_LEFT" spacing="10">

							<TextField fx:id="customerSearchField"
								promptText="Search by name, phone, or customer code"
								HBox.hgrow="ALWAYS" styleClass="customer-search" />

							<Button text="Search" mnemonicParsing="false"
								styleClass="search-button" />

							<Separator orientation="VERTICAL" prefHeight="28" />

							<Button text="All" mnemonicParsing="false"
								styleClass="filter-button filter-active" />

							<Button text="With Debt" mnemonicParsing="false"
								styleClass="filter-button" />

							<Button text="Clear" mnemonicParsing="false"
								styleClass="filter-button" />

							<HBox HBox.hgrow="ALWAYS" />

							<Button text="+ New Customer" mnemonicParsing="false"
								styleClass="new-customer-button" />

						</HBox>

					</top>


					<!-- ========================================= CUSTOMER TABLE ========================================= -->

					<center>

						<TableView fx:id="customersTable"
							styleClass="customers-table">

							<columns>

								<TableColumn fx:id="customerCodeColumn" text="CODE"
									prefWidth="100" />

								<TableColumn fx:id="customerNameColumn"
									text="CUSTOMER" prefWidth="270" minWidth="220" />

								<TableColumn fx:id="phoneColumn" text="PHONE"
									prefWidth="150" />

								<TableColumn fx:id="totalPurchasesColumn"
									text="PURCHASES" prefWidth="130" />

								<TableColumn fx:id="balanceColumn" text="BALANCE"
									prefWidth="135" />

								<TableColumn fx:id="lastPurchaseColumn"
									text="LAST PURCHASE" prefWidth="140" />

								<TableColumn fx:id="statusColumn" text="STATUS"
									prefWidth="105" />

							</columns>

						</TableView>

					</center>


					<!-- ========================================= SELECTED CUSTOMER SUMMARY 
						========================================= -->

					<bottom>

						<VBox spacing="12" styleClass="customer-summary">

							<Separator />

							<HBox alignment="CENTER_LEFT" spacing="22">

								<!-- CUSTOMER -->

								<VBox prefWidth="220" spacing="3">

									<Label text="SELECTED CUSTOMER"
										styleClass="summary-label" />

									<Label fx:id="selectedCustomerName"
										text="No customer selected" styleClass="customer-name" />

								</VBox>


								<!-- PHONE -->

								<VBox prefWidth="150" spacing="3">

									<Label text="PHONE" styleClass="summary-label" />

									<Label fx:id="selectedCustomerPhone" text="—"
										styleClass="summary-value" />

								</VBox>


								<!-- BALANCE -->

								<VBox prefWidth="150" spacing="3">

									<Label text="BALANCE" styleClass="summary-label" />

									<Label fx:id="selectedCustomerBalance" text="Rs. 0.00"
										styleClass="customer-balance" />

								</VBox>


								<HBox HBox.hgrow="ALWAYS" />


								<!-- ACTIONS -->

								<Button text="History" mnemonicParsing="false"
									styleClass="summary-action" />

								<Button text="Payment" mnemonicParsing="false"
									styleClass="summary-payment" />

								<Button text="Edit" mnemonicParsing="false"
									styleClass="summary-action" />

							</HBox>


							<!-- KEYBOARD HELP -->

							<HBox alignment="CENTER_LEFT" spacing="8">

								<Label text="↑ ↓" styleClass="keyboard-key" />

								<Label text="Navigate" styleClass="keyboard-label" />

								<Label text="Enter" styleClass="keyboard-key" />

								<Label text="Open" styleClass="keyboard-label" />

								<Label text="N" styleClass="keyboard-key" />

								<Label text="New" styleClass="keyboard-label" />

								<Label text="P" styleClass="keyboard-key" />

								<Label text="Payment" styleClass="keyboard-label" />

								<HBox HBox.hgrow="ALWAYS" />

								<Label text="F10" styleClass="keyboard-key" />

								<Label text="More commands" styleClass="keyboard-label" />

							</HBox>

						</VBox>

					</bottom>

				</BorderPane>

			</Tab>


			<!-- ================================================= CUSTOMER HISTORY 
				TAB ================================================= -->

			<Tab text="Customer History" closable="false">

				<BorderPane styleClass="history-content">

					<padding>
						<Insets top="18" right="18" bottom="18" left="18" />
					</padding>


					<top>

						<HBox alignment="CENTER_LEFT" spacing="10">

							<VBox spacing="2">

								<Label fx:id="historyCustomerName" text="Customer"
									styleClass="history-customer-name" />

								<Label text="Sales and payment history"
									styleClass="history-subtitle" />

							</VBox>

							<HBox HBox.hgrow="ALWAYS" />

							<Button text="Back to Customers" mnemonicParsing="false"
								styleClass="back-button" />

						</HBox>

					</top>


					<center>

						<TableView fx:id="customerHistoryTable"
							styleClass="history-table">

							<columns>

								<TableColumn fx:id="historyDateColumn" text="DATE"
									prefWidth="130" />

								<TableColumn fx:id="historyReferenceColumn"
									text="REFERENCE" prefWidth="150" />

								<TableColumn fx:id="historyTypeColumn" text="TYPE"
									prefWidth="120" />

								<TableColumn fx:id="historyAmountColumn"
									text="AMOUNT" prefWidth="140" />

								<TableColumn fx:id="historyPaidColumn" text="PAID"
									prefWidth="130" />

								<TableColumn fx:id="historyBalanceColumn"
									text="BALANCE" prefWidth="140" />

								<TableColumn fx:id="historyStatusColumn"
									text="STATUS" prefWidth="110" />

							</columns>

						</TableView>

					</center>

				</BorderPane>

			</Tab>

		</TabPane>

	</center>

</BorderPane>