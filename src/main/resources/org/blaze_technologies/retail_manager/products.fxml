<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:id="productsRoot"
	fx:controller="org.blaze_technologies.retail_manager.controllers.ProductsController"
	styleClass="products">

	<padding>
		<Insets top="22" right="28" bottom="20" left="28" />
	</padding>


	<!-- ===================================================== HEADER ===================================================== -->

	<top>

		<HBox alignment="BOTTOM_LEFT" spacing="20"
			styleClass="products-header">

			<VBox spacing="3">

				<Label text="Products" styleClass="page-title" />

				<Label text="Manage products and inventory"
					styleClass="page-subtitle" />

			</VBox>

			<HBox HBox.hgrow="ALWAYS" />

			<VBox alignment="BOTTOM_RIGHT" spacing="2">

				<Label text="INVENTORY" styleClass="header-label" />

				<Label fx:id="productCountLabel" text="0 products"
					styleClass="header-value" />

			</VBox>

		</HBox>

	</top>


	<!-- ===================================================== CENTER ===================================================== -->

	<center>

		<TabPane fx:id="productsTabs" tabClosingPolicy="UNAVAILABLE"
			styleClass="products-tabs">


			<!-- ================================================= PRODUCTS TAB ================================================= -->

			<Tab text="Products" closable="false">

				<BorderPane styleClass="products-content">

					<padding>
						<Insets top="16" right="18" bottom="18" left="18" />
					</padding>


					<!-- ========================================= TOOLBAR ========================================= -->

					<top>

						<HBox alignment="CENTER_LEFT" spacing="10">

							<TextField fx:id="productSearchField"
								promptText="Search by name, code, or barcode"
								HBox.hgrow="ALWAYS" styleClass="product-search" />

							<Button text="Search" mnemonicParsing="false"
								styleClass="search-button" />

							<Separator orientation="VERTICAL" prefHeight="28" />

							<Button text="All" mnemonicParsing="false"
								styleClass="filter-button filter-active" />

							<Button text="Low Stock" mnemonicParsing="false"
								styleClass="filter-button" />

							<Button text="Inactive" mnemonicParsing="false"
								styleClass="filter-button" />

							<HBox HBox.hgrow="ALWAYS" />

							<Button text="+ New Product" mnemonicParsing="false"
								styleClass="new-product-button" />

						</HBox>

					</top>


					<!-- ========================================= PRODUCT TABLE ========================================= -->

					<center>

						<TableView fx:id="productsTable"
							styleClass="products-table">

							<columns>

								<TableColumn fx:id="codeColumn" text="CODE"
									prefWidth="110" />

								<TableColumn fx:id="barcodeColumn" text="BARCODE"
									prefWidth="145" />

								<TableColumn fx:id="nameColumn" text="PRODUCT"
									prefWidth="280" minWidth="220" maxWidth="400" />

								<TableColumn fx:id="categoryColumn" text="CATEGORY"
									prefWidth="150" />

								<TableColumn fx:id="unitColumn" text="UNIT"
									prefWidth="75" />

								<TableColumn fx:id="stockColumn" text="STOCK"
									prefWidth="100" />

								<TableColumn fx:id="costPriceColumn" text="COST"
									prefWidth="120" />

								<TableColumn fx:id="sellingPriceColumn"
									text="SELLING" prefWidth="125" />

								<TableColumn fx:id="statusColumn" text="STATUS"
									prefWidth="100" />

							</columns>

						</TableView>

					</center>


					<!-- ========================================= FOOTER ACTION AREA ========================================= -->

					<bottom>

						<HBox alignment="CENTER_LEFT" spacing="8"
							styleClass="products-footer">

							<Label text="↑ ↓" styleClass="keyboard-key" />

							<Label text="Navigate" styleClass="keyboard-label" />

							<Label text="Enter" styleClass="keyboard-key" />

							<Label text="Edit" styleClass="keyboard-label" />

							<Label text="N" styleClass="keyboard-key" />

							<Label text="New" styleClass="keyboard-label" />

							<Label text="S" styleClass="keyboard-key" />

							<Label text="Stock" styleClass="keyboard-label" />

							<HBox HBox.hgrow="ALWAYS" />

							<Label fx:id="selectionStatusLabel"
								text="No product selected" styleClass="selection-status" />

						</HBox>

					</bottom>

				</BorderPane>

			</Tab>


			<!-- ================================================= CATEGORIES TAB 
				================================================= -->

			<Tab text="Categories" closable="false">

				<BorderPane styleClass="categories-content">

					<padding>
						<Insets top="18" right="18" bottom="18" left="18" />
					</padding>


					<top>

						<HBox alignment="CENTER_LEFT" spacing="10">

							<TextField fx:id="categorySearchField"
								promptText="Search categories" HBox.hgrow="ALWAYS"
								styleClass="category-search" />

							<Button text="Search" mnemonicParsing="false"
								styleClass="search-button" />

							<HBox HBox.hgrow="ALWAYS" />

							<Button text="+ New Category" mnemonicParsing="false"
								styleClass="new-product-button" />

						</HBox>

					</top>


					<center>

						<TableView fx:id="categoriesTable"
							styleClass="categories-table">

							<columns>

								<TableColumn fx:id="categoryNameColumn"
									text="CATEGORY" prefWidth="320" />

								<TableColumn fx:id="categoryCodeColumn" text="CODE"
									prefWidth="150" />

								<TableColumn fx:id="categoryProductCountColumn"
									text="PRODUCTS" prefWidth="130" />

								<TableColumn fx:id="categoryStatusColumn"
									text="STATUS" prefWidth="120" />

							</columns>

						</TableView>

					</center>


					<bottom>

						<HBox alignment="CENTER_LEFT" spacing="8"
							styleClass="products-footer">

							<Label text="↑ ↓" styleClass="keyboard-key" />

							<Label text="Navigate" styleClass="keyboard-label" />

							<Label text="Enter" styleClass="keyboard-key" />

							<Label text="Edit" styleClass="keyboard-label" />

							<HBox HBox.hgrow="ALWAYS" />

							<Label text="F10" styleClass="keyboard-key" />

							<Label text="More commands" styleClass="keyboard-label" />

						</HBox>

					</bottom>

				</BorderPane>

			</Tab>

		</TabPane>

	</center>

</BorderPane>