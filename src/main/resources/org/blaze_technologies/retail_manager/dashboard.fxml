<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:id="dashboardRoot"
        fx:controller="org.blaze_technologies.retail_manager.controllers.DashboardController"
        styleClass="dashboard">

    <padding>
        <Insets top="26" right="32" bottom="24" left="32"/>
    </padding>


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <top>

        <HBox
                alignment="BOTTOM_LEFT"
                spacing="20"
                styleClass="dashboard-header">

            <VBox spacing="3">

                <Label
                        text="Dashboard"
                        styleClass="page-title"/>

                <Label
                        text="Today's shop activity"
                        styleClass="page-subtitle"/>

            </VBox>

            <HBox HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="BOTTOM_RIGHT"
                    spacing="2">

                <Label
                        text="SUNDAY"
                        styleClass="date-day"/>

                <Label
                        text="16 AUGUST 2026"
                        styleClass="date-value"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <GridPane
                hgap="18"
                vgap="18"
                styleClass="dashboard-content">

            <columnConstraints>

                <ColumnConstraints
                        percentWidth="50"
                        hgrow="ALWAYS"/>

                <ColumnConstraints
                        percentWidth="28"
                        hgrow="ALWAYS"/>

                <ColumnConstraints
                        percentWidth="22"
                        hgrow="ALWAYS"/>

            </columnConstraints>

            <rowConstraints>

                <RowConstraints
                        percentHeight="43"
                        vgrow="ALWAYS"/>

                <RowConstraints
                        percentHeight="57"
                        vgrow="ALWAYS"/>

            </rowConstraints>


            <!-- =================================================
                 TODAY'S SALES
                 ================================================= -->

            <VBox
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"
                    GridPane.columnSpan="1"
                    spacing="14"
                    styleClass="hero-panel">

                <HBox alignment="CENTER_LEFT">

                    <Label
                            text="TODAY'S SALES"
                            styleClass="hero-label"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Label
                            text="F2"
                            styleClass="hero-shortcut"/>

                </HBox>

                <VBox
                        VBox.vgrow="ALWAYS"
                        alignment="CENTER_LEFT"
                        spacing="4">

                    <Label
                            text="Rs. 128,450.00"
                            styleClass="hero-value"/>

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10">

                        <Label
                                text="+12.8%"
                                styleClass="hero-positive"/>

                        <Label
                                text="compared with yesterday"
                                styleClass="hero-secondary"/>

                    </HBox>

                </VBox>

                <Separator
                        styleClass="hero-separator"/>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="32">

                    <VBox spacing="2">

                        <Label
                                text="32"
                                styleClass="hero-stat-value"/>

                        <Label
                                text="TRANSACTIONS"
                                styleClass="hero-stat-label"/>

                    </VBox>

                    <VBox spacing="2">

                        <Label
                                text="Rs. 4,014"
                                styleClass="hero-stat-value"/>

                        <Label
                                text="AVG. SALE"
                                styleClass="hero-stat-label"/>

                    </VBox>

                </HBox>

            </VBox>


            <!-- =================================================
                 OUTSTANDING DEBTS
                 ================================================= -->

            <VBox
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"
                    spacing="12"
                    styleClass="metric-panel">

                <HBox alignment="CENTER_LEFT">

                    <Label
                            text="OUTSTANDING"
                            styleClass="panel-label"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Label
                            text="7"
                            styleClass="small-count"/>

                </HBox>

                <VBox
                        VBox.vgrow="ALWAYS"
                        alignment="CENTER_LEFT"
                        spacing="5">

                    <Label
                            text="Rs. 84,200"
                            styleClass="metric-value"/>

                    <Label
                            text="from 7 customers"
                            styleClass="metric-secondary"/>

                </VBox>

                <Button
                        text="View Debtors"
                        mnemonicParsing="false"
                        maxWidth="Infinity"
                        styleClass="secondary-action"/>

            </VBox>


            <!-- =================================================
                 LOW STOCK
                 ================================================= -->

            <VBox
                    GridPane.columnIndex="2"
                    GridPane.rowIndex="0"
                    spacing="12"
                    styleClass="metric-panel stock-panel">

                <HBox alignment="CENTER_LEFT">

                    <Label
                            text="LOW STOCK"
                            styleClass="panel-label"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Label
                            text="12"
                            styleClass="warning-count"/>

                </HBox>

                <VBox
                        VBox.vgrow="ALWAYS"
                        alignment="CENTER_LEFT"
                        spacing="5">

                    <Label
                            text="12 products"
                            styleClass="metric-value"/>

                    <Label
                            text="need attention"
                            styleClass="metric-secondary"/>

                </VBox>

                <Button
                        text="Review Stock"
                        mnemonicParsing="false"
                        maxWidth="Infinity"
                        styleClass="secondary-action"/>

            </VBox>


            <!-- =================================================
                 RECENT TRANSACTIONS
                 ================================================= -->

            <VBox
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"
                    GridPane.columnSpan="2"
                    spacing="14"
                    styleClass="transactions-panel">

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="2">

                        <Label
                                text="Recent Transactions"
                                styleClass="section-title"/>

                        <Label
                                text="Latest activity in the shop"
                                styleClass="section-subtitle"/>

                    </VBox>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Button
                            text="View All"
                            mnemonicParsing="false"
                            styleClass="text-action"/>

                </HBox>

                <Separator/>

                <HBox
                        alignment="CENTER_LEFT"
                        styleClass="transaction-header">

                    <Label
                            text="TIME"
                            prefWidth="75"/>

                    <Label
                            text="REFERENCE"
                            HBox.hgrow="ALWAYS"/>

                    <Label
                            text="CUSTOMER"
                            prefWidth="160"/>

                    <Label
                            text="AMOUNT"
                            prefWidth="120"/>

                    <Label
                            text="STATUS"
                            prefWidth="90"/>

                </HBox>

                <ListView
                        fx:id="recentTransactionsList"
                        VBox.vgrow="ALWAYS"
                        focusTraversable="false"
                        styleClass="transaction-list"/>

            </VBox>


            <!-- =================================================
                 QUICK ACTIONS
                 ================================================= -->

            <VBox
                    GridPane.columnIndex="2"
                    GridPane.rowIndex="1"
                    spacing="14"
                    styleClass="actions-panel">

                <VBox spacing="2">

                    <Label
                            text="Quick Actions"
                            styleClass="section-title"/>

                    <Label
                            text="Common operations"
                            styleClass="section-subtitle"/>

                </VBox>

                <VBox
                        VBox.vgrow="ALWAYS"
                        spacing="10">

                    <Button
                            text="New Sale"
                            mnemonicParsing="false"
                            maxWidth="Infinity"
                            VBox.vgrow="ALWAYS"
                            styleClass="action-button action-primary"/>

                    <Button
                            text="New Product"
                            mnemonicParsing="false"
                            maxWidth="Infinity"
                            VBox.vgrow="ALWAYS"
                            styleClass="action-button"/>

                    <Button
                            text="New Customer"
                            mnemonicParsing="false"
                            maxWidth="Infinity"
                            VBox.vgrow="ALWAYS"
                            styleClass="action-button"/>

                </VBox>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="8"
                        styleClass="command-hint">

                    <Label
                            text="F10"
                            styleClass="shortcut-badge"/>

                    <Label
                            text="More actions"
                            styleClass="hint-text"/>

                </HBox>

            </VBox>

        </GridPane>

    </center>

</BorderPane>