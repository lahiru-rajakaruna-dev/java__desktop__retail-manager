<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1" prefWidth="1600" prefHeight="900"
	fx:controller="org.blaze_technologies.retail_manager.controllers.ApplicationController"
	fx:id="appRoot">

	<!-- ===================================================== -->
	<!-- Header -->
	<!-- ===================================================== -->

	<top>

		<VBox spacing="0">

			<HBox styleClass="app-header" alignment="CENTER_LEFT">

				<padding>
					<Insets top="12" right="20" bottom="12" left="20" />
				</padding>

				<Label text="Retail Manager" styleClass="app-title" />

				<Region HBox.hgrow="ALWAYS" />

				<Label text="Admin" styleClass="header-user" />

			</HBox>
			<!-- =============================================== -->
			<!-- Main Module Tabs -->
			<!-- =============================================== -->
			<fx:include fx:id="tabbar" source="tabbar.fxml" />
		</VBox>

	</top>
	<!-- ===================================================== -->
	<!-- Active Screen -->
	<!-- ===================================================== -->
	<center>
		<StackPane fx:id="contentPane" styleClass="content-pane" />
	</center>
	<!-- ===================================================== -->
	<!-- Context Shortcut Bar -->
	<!-- ===================================================== -->
	<bottom>
		<HBox spacing="16" alignment="CENTER_LEFT"
			styleClass="status-bar">

			<padding>
				<Insets top="8" right="18" bottom="8" left="18" />
			</padding>

			<Label text="Esc Back" styleClass="status-shortcut" />

			<Label text="F2 Search" styleClass="status-shortcut" />

			<Label text="Ctrl+N New" styleClass="status-shortcut" />

			<Label text="Ctrl+S Save" styleClass="status-shortcut" />

			<Label text="Ctrl+P Print" styleClass="status-shortcut" />

			<Region HBox.hgrow="ALWAYS" />

			<Label text="Ready" styleClass="status-text" />

		</HBox>

	</bottom>

</BorderPane>